# TradeScope AI backend configuration.
# Copy to backend/.env (git-ignored) and fill in. Never commit backend/.env.
# Real environment variables take precedence over values in this file.

# --- Alpaca Market Data API (read-only) ---------------------------------------
# Leave both blank to run on clearly-labelled DEMO DATA.
# Keys: https://app.alpaca.markets -> (Paper or Live account) -> API Keys.
# APCA_API_KEY_ID / APCA_API_SECRET_KEY are also accepted (Alpaca's own names).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Feed. Coverage depends on your Alpaca market data subscription:
#   iex          - Investors Exchange only, real-time. Free plan. Volume is IEX-only.
#   sip          - all US exchanges, real-time. Requires Algo Trader Plus.
#   delayed_sip  - all US exchanges, 15-minute delayed. Works on the free plan.
ALPACA_FEED=iex

# Corporate-action adjustment for historical bars: raw | split | dividend | all
ALPACA_ADJUSTMENT=split

# Trading API host, used ONLY for the market calendar (GET /v2/calendar).
# Use https://api.alpaca.markets if your keys are live-account keys.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Client-side limits (Alpaca free plan: 200 requests/minute).
ALPACA_RATE_LIMIT_PER_MIN=190
ALPACA_MAX_RETRIES=3
ALPACA_TIMEOUT_SECONDS=15

# --- Claude AI explanations ----------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# --- App -------------------------------------------------------------------------
WATCHLIST=SPY,QQQ,NVDA,TSLA,AAPL,AMD,MSFT,META,AMZN
SCAN_INTERVAL_SECONDS=30
CORS_ORIGINS=http://localhost:3000
# DATABASE_PATH=./tradescope.db
