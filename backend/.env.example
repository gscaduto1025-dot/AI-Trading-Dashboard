# TradeScope AI backend configuration.
# Copy to backend/.env (git-ignored) and fill in. Never commit backend/.env.
# Real environment variables take precedence over values in this file.

# --- Alpaca Market Data API (read-only) ---------------------------------------
# Leave both blank to run on clearly-labelled DEMO DATA.
# Keys: https://app.alpaca.markets -> (Paper or Live account) -> API Keys.
# APCA_API_KEY_ID / APCA_API_SECRET_KEY are also accepted (Alpaca's own names).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Feed. Coverage depends on your Alpaca market data subscription:
#   iex          - Investors Exchange only, real-time. Free plan. Volume is IEX-only.
#   sip          - all US exchanges, real-time. Requires Algo Trader Plus.
#   delayed_sip  - all US exchanges, 15-minute delayed. Works on the free plan.
ALPACA_FEED=iex

# Corporate-action adjustment for historical bars: raw | split | dividend | all
ALPACA_ADJUSTMENT=split

# Options chain feed (Options tab):
#   indicative - free on every account. Quotes are an indicative derivative of OPRA,
#                not actual OPRA quotes; trades are delayed 15 minutes. Contracts can be
#                explored but TradeScope never recommends one from this feed.
#   opra       - real-time OPRA. Requires Algo Trader Plus + a signed OPRA agreement.
ALPACA_OPTIONS_FEED=indicative

# Trading API host, used ONLY for read-only reference data: the market calendar
# (GET /v2/calendar) and the option contract list with open interest
# (GET /v2/options/contracts). TradeScope never calls any order endpoint.
# Use https://api.alpaca.markets if your keys are live-account keys.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Client-side limits (Alpaca free plan: 200 requests/minute).
ALPACA_RATE_LIMIT_PER_MIN=190
ALPACA_MAX_RETRIES=3
ALPACA_TIMEOUT_SECONDS=15

# --- Claude AI explanations ----------------------------------------------------
# Secret: never commit it. Prefer exporting it in the environment that starts the
# backend; if you put it here, keep this file private (chmod 600 backend/.env).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Cost controls: hard caps on Claude calls (cached answers are free and not counted).
CLAUDE_MAX_CALLS_PER_MINUTE=6
CLAUDE_MAX_CALLS_PER_DAY=100
CLAUDE_MAX_DAILY_COST_USD=5

# --- Market scanner (liquid-stock universe) -------------------------------------
# Server-side scan of the top UNIVERSE_SIZE US stocks by 20-session consolidated dollar
# volume (Alpaca data). 0 disables the schedule. See docs/SCANNER.md for throughput.
UNIVERSE_SCAN_INTERVAL_SECONDS=900
UNIVERSE_SIZE=100
UNIVERSE_MIN_PRICE=5
UNIVERSE_MIN_ADV_USD=50000000
UNIVERSE_INCLUDE_ETFS=false
# Always include / never include (comma lists)
UNIVERSE_INCLUDE=
UNIVERSE_EXCLUDE=
UNIVERSE_REBUILD_HOURS=24
UNIVERSE_START_DELAY_SECONDS=60
UNIVERSE_WARMUP_WORKERS=4
# Downloaded candles are saved on shutdown/after scans and restored on start (warm restart).
RAW_CACHE_PERSIST=true
# RAW_CACHE_DIR=backend/data/cache

# --- App -------------------------------------------------------------------------
WATCHLIST=SPY,QQQ,NVDA,TSLA,AAPL,AMD,MSFT,META,AMZN
SCAN_INTERVAL_SECONDS=30

# Optional: POST every alert (types chosen in alert settings) to a webhook so you are
# notified while the dashboard is closed - Slack/Discord/Teams incoming webhook, ntfy.sh,
# Zapier, or your own endpoint. Treat it as a secret; it is never logged or returned.
ALERT_WEBHOOK_URL=
CORS_ORIGINS=http://localhost:3000
# DATABASE_PATH=./tradescope.db
