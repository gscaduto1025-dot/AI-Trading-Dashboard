# --- Market data (Alpaca Market Data API, read-only) ---
# Leave blank to run on clearly-labelled DEMO DATA.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "iex" works on Alpaca's free plan; "sip" requires a paid data subscription.
ALPACA_FEED=iex

# --- Claude AI explanations ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# --- App ---
WATCHLIST=SPY,QQQ,NVDA,TSLA,AAPL,AMD,MSFT,META,AMZN
SCAN_INTERVAL_SECONDS=300
CORS_ORIGINS=http://localhost:3000
# DATABASE_PATH=./tradescope.db
